import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.Scanner;
import java.util.Set;
import java.util.TreeMap;
import java.util.TreeSet;

public class CityDistances {
    private static final Path FILE = Paths.get("distances.txt");
    private static final Set<String> cities = new TreeSet<>();
    private static final Map<String, Integer> distances = new TreeMap<>();

    private static String key(String a, String b) {
        return a.compareTo(b) < 0 ? a + ";" + b : b + ";" + a;
    }

    private static void load() {
        if (!Files.exists(FILE)) {
            return;
        }
        try {
            for (String line : Files.readAllLines(FILE)) {
                String[] p = line.split(";");
                if (p.length == 2 && p[0].equals("C")) {
                    cities.add(p[1]);
                } else if (p.length == 4 && p[0].equals("D")) {
                    distances.put(key(p[1], p[2]), Integer.parseInt(p[3]));
                }
            }
        } catch (IOException | NumberFormatException e) {
            System.out.println("Ошибка чтения файла: " + e.getMessage());
        }
    }

    private static void save() {
        List<String> lines = new ArrayList<>();
        for (String c : cities) {
            lines.add("C;" + c);
        }
        for (Map.Entry<String, Integer> e : distances.entrySet()) {
            lines.add("D;" + e.getKey() + ";" + e.getValue());
        }
        try {
            Files.write(FILE, lines);
        } catch (IOException e) {
            System.out.println("Ошибка записи файла: " + e.getMessage());
        }
    }

    private static int readInt(Scanner in, String prompt) {
        while (true) {
            System.out.print(prompt);
            try {
                int v = Integer.parseInt(in.nextLine().trim());
                if (v > 0) {
                    return v;
                }
            } catch (NumberFormatException ignored) {
            }
            System.out.println("Введите положительное целое число.");
        }
    }

    private static String readName(Scanner in, String prompt) {
        while (true) {
            System.out.print(prompt);
            String s = in.nextLine().trim();
            if (!s.isEmpty() && !s.contains(";")) {
                return s;
            }
            System.out.println("Название не должно быть пустым или содержать ';'.");
        }
    }

    private static void addCity(Scanner in) {
        String name = readName(in, "Название города: ");
        if (cities.add(name)) {
            save();
            System.out.println("Город добавлен.");
        } else {
            System.out.println("Такой город уже есть.");
        }
    }

    private static void addDistance(Scanner in) {
        String a = readName(in, "Первый город: ");
        String b = readName(in, "Второй город: ");
        if (a.equalsIgnoreCase(b)) {
            System.out.println("Города должны различаться.");
            return;
        }
        int d = readInt(in, "Расстояние (км): ");
        cities.add(a);
        cities.add(b);
        distances.put(key(a, b), d);
        save();
        System.out.println("Расстояние сохранено.");
    }

    private static void showDistance(Scanner in) {
        String a = readName(in, "Первый город: ");
        String b = readName(in, "Второй город: ");
        Integer d = distances.get(key(a, b));
        if (d == null) {
            System.out.println("Расстояние не найдено.");
        } else {
            System.out.println(a + " — " + b + ": " + d + " км");
        }
    }

    private static void showAll() {
        if (cities.isEmpty()) {
            System.out.println("Данных нет.");
            return;
        }
        System.out.println("Города: " + String.join(", ", cities));
        for (Map.Entry<String, Integer> e : distances.entrySet()) {
            String[] p = e.getKey().split(";");
            System.out.println(p[0] + " — " + p[1] + ": " + e.getValue() + " км");
        }
    }

    private static void removeCity(Scanner in) {
        String name = readName(in, "Город для удаления: ");
        if (!cities.remove(name)) {
            System.out.println("Такого города нет.");
            return;
        }
        distances.keySet().removeIf(k -> {
            String[] p = k.split(";");
            return p[0].equals(name) || p[1].equals(name);
        });
        save();
        System.out.println("Город и связанные расстояния удалены.");
    }

    public static void main(String[] args) {
        load();
        Scanner in = new Scanner(System.in);
        while (true) {
            System.out.println();
            System.out.println("1. Добавить город");
            System.out.println("2. Добавить расстояние между городами");
            System.out.println("3. Узнать расстояние");
            System.out.println("4. Показать все данные");
            System.out.println("5. Удалить город");
            System.out.println("0. Выход");
            System.out.print("Выбор: ");
            switch (in.nextLine().trim()) {
                case "1" -> addCity(in);
                case "2" -> addDistance(in);
                case "3" -> showDistance(in);
                case "4" -> showAll();
                case "5" -> removeCity(in);
                case "0" -> {
                    return;
                }
                default -> System.out.println("Неверный пункт меню.");
            }
        }
    }
}
